# -----------------------------------------------------------------------------
# MailleMum — variables d'environnement
#
# En local : copier ce fichier en .env.local (ignoré par git) et le remplir.
# En production : les définir dans Vercel (Settings → Environment Variables),
# de préférence en type « Sensitive » pour les secrets.
# Ne jamais mettre de clé de production (sk_live_…, base de prod) sur un poste de dev.
# -----------------------------------------------------------------------------

# --- Base de données ---------------------------------------------------------
# URI MongoDB, nom de la base compris. En local : mongodb://localhost:27017/wool-starter-dev
# (les tests unitaires et e2e utilisent une MongoDB en mémoire et ignorent cette valeur).
MONGODB_URI=

# --- Authentification (next-auth) -------------------------------------------
# Secret de signature des sessions JWT. Générer avec : openssl rand -base64 32
AUTH_SECRET=
# URL du site vue par next-auth (en local : http://localhost:3000).
NEXTAUTH_URL=
# Connexion Google (Google Cloud Console → Identifiants → ID client OAuth).
# URI de redirection autorisée : <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- URL publique ------------------------------------------------------------
# URL canonique du site, utilisée dans les liens des emails (prod : https://www.maillemum.fr).
NEXT_PUBLIC_APP_URL=

# --- Paiement (Stripe) -------------------------------------------------------
# Clé secrète. En local, uniquement une clé de test (sk_test_… ou rk_test_…).
STRIPE_SECRET_KEY=
# Secret de signature du webhook /api/stripe/webhook (whsec_…).
# En local : `stripe listen --forward-to localhost:3000/api/stripe/webhook --print-secret`.
STRIPE_WEBHOOK_SECRET=
# Tests seulement : redirige l'API Stripe vers le faux Stripe des tests e2e.
# Ignorée en production. Laisser vide.
STRIPE_API_BASE_URL=

# --- Images (Cloudinary) -----------------------------------------------------
# Nom du cloud, public (sert à construire les URL des images).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Clés API, côté serveur uniquement : signent les envois de l'admin.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Facultatif : preset d'envoi SIGNÉ appliqué aux envois de l'admin.
CLOUDINARY_UPLOAD_PRESET=

# --- Emails (Resend) ---------------------------------------------------------
# Clé API Resend (inutile en local si EMAIL_TRANSPORT=preview).
RESEND_API_KEY=
# Expéditeur des emails, sur un domaine vérifié dans Resend (ex. MailleMum <noreply@exemple.fr>).
EMAIL_FROM=
# Adresse qui reçoit les notifications de la boutique (commandes, contact, alertes).
SELLER_EMAIL=
# Hors production : "preview" (défaut) capture les emails dans .emails/ et /dev/emails
# au lieu de les envoyer ; "resend" les envoie vraiment.
EMAIL_TRANSPORT=
# Hors production : "0" pour ne pas ouvrir automatiquement l'aperçu d'un email capturé.
EMAIL_PREVIEW_OPEN=

# --- Génération de descriptions (Google Gemini) ------------------------------
# Clé API Gemini, pour le bouton « Générer la description » de l'admin (facultatif).
GEMINI_API_KEY=

# --- Étiquettes d'expédition -------------------------------------------------
# Adresse de l'expéditeur imprimée sur les étiquettes (facultatif).
SHIPPING_SENDER_NAME=
SHIPPING_SENDER_ADDRESS=
SHIPPING_SENDER_POSTAL_CODE=
SHIPPING_SENDER_CITY=
SHIPPING_SENDER_COUNTRY=

# --- Tâches planifiées -------------------------------------------------------
# Secret du cron Vercel /api/cron/release-locks (envoyé en « Authorization: Bearer »).
# Sans valeur, la route refuse tous les appels. Générer avec : openssl rand -hex 32
CRON_SECRET=

# Les variables VERCEL_* et NODE_ENV sont fournies par la plateforme : ne pas les définir.
